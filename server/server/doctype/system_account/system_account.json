{
 "autoname": "field:username",
 "sort_field": "username",
 "sort_order": "ASC",
 "description": "One account that exists on this host. Current state; changes are in System Account Change. Password HASHES are never recorded — only whether a password is set, locked or absent, because an app that watches for compromise must not become the richest target on the estate.",
 "fields": [
